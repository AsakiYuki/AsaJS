{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "dist/js",
		"declarationDir": "dist/types",
		"declaration": true,
		"sourceMap": false,
		"strict": true,
		"esModuleInterop": true,
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo"
	},
	"include": ["src/**/*", "config.d.ts"],
	"exclude": ["node_modules"]
}
